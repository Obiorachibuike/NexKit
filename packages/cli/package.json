{
  "name": "@nexkitjs/cli",
  "version": "0.1.0",
  "description": "NexKit CLI: scaffold config, generate middleware, and diagnose your project setup.",
  "keywords": [
    "nexkit",
    "cli",
    "scaffold",
    "generator"
  ],
  "license": "MIT",
  "author": "NexKit contributors",
  "homepage": "https://github.com/Obiorachibuike/NexKit/tree/main/packages/cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Obiorachibuike/NexKit.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/Obiorachibuike/NexKit/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "nexkit": "dist/bin.js"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "node ../../scripts/clean.mjs .",
    "test": "vitest run --project cli"
  }
}
