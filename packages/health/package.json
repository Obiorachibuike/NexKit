{
  "name": "@nexkitjs/health",
  "version": "0.1.0",
  "description": "Liveness and readiness checks with timeouts, custom check registration, and sanitized reports.",
  "keywords": [
    "nexkit",
    "health",
    "healthcheck",
    "readiness",
    "liveness"
  ],
  "license": "MIT",
  "author": "NexKit contributors",
  "homepage": "https://github.com/Obiorachibuike/NexKit/tree/main/packages/health#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Obiorachibuike/NexKit.git",
    "directory": "packages/health"
  },
  "bugs": {
    "url": "https://github.com/Obiorachibuike/NexKit/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "node ../../scripts/clean.mjs .",
    "test": "vitest run --project health"
  },
  "dependencies": {
    "@nexkitjs/core": "0.1.0"
  }
}
