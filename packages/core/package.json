{
  "name": "@nexkitjs/core",
  "version": "0.1.0",
  "description": "Framework-agnostic primitives for NexKit: redaction, request context, secure header presets, timeouts, and schema interop.",
  "keywords": [
    "nexkit",
    "backend",
    "redaction",
    "request-context",
    "security-headers"
  ],
  "license": "MIT",
  "author": "NexKit contributors",
  "homepage": "https://github.com/Obiorachibuike/NexKit/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Obiorachibuike/NexKit.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Obiorachibuike/NexKit/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "node ../../scripts/clean.mjs .",
    "test": "vitest run --project core"
  }
}
