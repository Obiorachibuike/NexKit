{
  "name": "@nexkitjs/ratelimit",
  "version": "0.1.0",
  "description": "Rate-limiting adapter interfaces and helpers for integrating established rate limiters into NexKit adapters.",
  "keywords": [
    "nexkit",
    "rate-limit",
    "ratelimit",
    "throttling"
  ],
  "license": "MIT",
  "author": "NexKit contributors",
  "homepage": "https://github.com/Obiorachibuike/NexKit/tree/main/packages/ratelimit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Obiorachibuike/NexKit.git",
    "directory": "packages/ratelimit"
  },
  "bugs": {
    "url": "https://github.com/Obiorachibuike/NexKit/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "node ../../scripts/clean.mjs .",
    "test": "vitest run --project ratelimit"
  },
  "dependencies": {
    "@nexkitjs/core": "0.1.0",
    "@nexkitjs/errors": "0.1.0"
  }
