# Generated by NexKit. Copy to .env and fill in the values.

# Runtime environment
# type: enum · one of: development | test | production · default: "development"
# NODE_ENV=development

# HTTP port to listen on
# type: port · default: 3000
# PORT=3000

# Minimum log level
# type: enum · one of: trace | debug | info | warn | error | fatal | silent · default: "info"
# LOG_LEVEL=info

# Primary database connection string
# type: url · optional
# DATABASE_URL=<secret>
