{
  "name": "@nexkit-examples/express-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Example Express application built with NexKit packages.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --import tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --project express-example"
  },
  "dependencies": {
    "@nexkitjs/config": "0.2.0",
    "@nexkitjs/core": "0.2.0",
    "@nexkitjs/errors": "0.2.0",
    "@nexkitjs/express": "0.2.0",
    "@nexkitjs/health": "0.2.0",
    "@nexkitjs/logger": "0.2.0",
    "@nexkitjs/ratelimit": "0.2.0",
    "@nexkitjs/response": "0.2.0",
    "express": "^5.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@nexkitjs/testing": "0.2.0",
    "@types/express": "^5.0.0",
    "tsx": "^4.20.0"
  }
}
